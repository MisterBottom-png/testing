{
  "name": "gemini-podcast-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-single-file.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "verify:single": "node scripts/verify-single-file.mjs",
    "test:runtime": "node scripts/runtime-smoke-repaired.mjs",
    "check": "npm test && npm run build && npm run verify:single && npm run test:runtime"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
