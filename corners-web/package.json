{
  "name": "corners-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @corners/web",
    "dev:server": "npm run dev --workspace @corners/server",
    "build": "npm run build --workspace @corners/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
