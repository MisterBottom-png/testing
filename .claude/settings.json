{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(rustup target add *)",
      "Bash(rustup component add *)",
      "Bash(rustfmt *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git -C upstream/* *)",
      "Bash(scripts/*)",
      "Bash(python3 .claude/hooks/backlog.py *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Edit(docs/00-decisions.md)",
      "Write(docs/00-decisions.md)",
      "Edit(deny.toml)",
      "Write(deny.toml)",
      "Bash(git push *)",
      "Bash(gh repo create *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session_start.py", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard_write.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/post_edit.py", "timeout": 90 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop_check.py", "timeout": 700 }
        ]
      }
    ]
  }
}
